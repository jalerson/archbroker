<%= content_for :head do %>
  <script type="text/javascript">

    function validates() {
      var validation = true;
      $(".error").hide();
      $(".has-error").removeClass("has-error");

      if($("#email").val() == "") {
        validation = false;
        $("#email").parent().addClass("has-error");
      } else {
        if(!validates_email($("#email").val())) {
          validation = false;
          $("#email").parent().addClass("has-error");
        }
      }

      return validation;
    }
  </script>
<% end %>

<h2>Lost your password?</h2>

<div class="panel panel-default">
  <div class="panel-body">
    <p>No problem! Please enter your e-mail address.</p>
    <%= form_tag({controller: "users", action: "reset_password"}, method: "post", role: "form", class: 'form-inline', onsubmit: 'return validates()') do %>
      <div class="form-group">
        <div class="input-group">
          <div class="input-group-addon">@</div>
          <input class="form-control" name="email" id="email" type="email" placeholder="E-mail address">
        </div>
      </div>
      <button type="submit" class="btn btn-success">Done!</button>
    <% end %>
  </div>
</div>