<%= content_for :head do %>
  <%= javascript_include_tag 'jquery-ui' %>
  <%= javascript_include_tag 'application' %>
  <%= javascript_include_tag 'jquery.fs.zoetrope.min' %>
  <%= javascript_include_tag 'toe.min' %>
  <%= javascript_include_tag 'jquery.mousewheel.min' %>
  <%= javascript_include_tag 'imgViewer.min' %>
  <%= javascript_include_tag 'imgNotes' %>
  <%= stylesheet_link_tag 'marker' %>
  
  <script type="text/javascript">
    $(function() {
      $(".error").hide();
    });

    var imgNotesExecuted = false;
    var maps = new Array();
    <% Region.all.each do |region| %>
      maps[<%= region.id %>] = "<%= region.map %>";
    <% end %>

    function display_map() {
      if($("#sale_region_id").val() == "") {
        imgNotesExecuted = false;
        $("#location_img").remove();
        $("#location_div").html("<img src='/assets/world_map.jpg' id='location_img'>");
        $("#location_img").imgNotes({canEdit: false});
      } else {
        imgNotesExecuted = true;
        map_name = maps[$("#sale_region_id").val()];
        $("#location_img").remove();
        $("#location_div").html("<img src='/assets/"+map_name+"' id='location_img'>");
        if(map_name == 'world_map.jpg') {
          $("#location_img").imgNotes({canEdit: true, zoomable: true});
        } else {
          $("#location_img").imgNotes({canEdit: true, zoomable: false});
        }
      }
      
      $("#location_img").imgNotes("option", "hAll", "middle");
      $("#location_img").imgNotes("option", "vAll", "bottom");

      $("#location_img").imgNotes("option", "onAdd", function() {
        $("#location_img").imgNotes("clear");
        return $(document.createElement('span')).addClass("marker");
      });

      $("#location_img").imgNotes("option", "onEdit", function() {
        return $(document.createElement('span')).addClass("marker");
      });
    }

    function validates() {
      var validation = true;
      $(".has-error").removeClass("has-error");
      $(".error").hide();

      if($("#sale_title").val() == "") {
        validation = false;
        $("#sale_title").parent().addClass("has-error");
        $("#title_required").show();
      }

      if($("#sale_price").val() == "") {
        validation = false;
        $("#sale_price").parent().addClass("has-error");
        $("#price_required").show();
      } else {
        if(!validates_integer($("#sale_price").val())) {
          validation = false;
          $("#sale_price").parent().addClass("has-error");
          $("#price_invalid").show();
        }
      }

      if($("#sale_contact_ingame").val() == "") {
        validation = false;
        $("#sale_contact_ingame").parent().addClass("has-error");
        $("#contact_ingame_required").show();
      }

      if($("#sale_contact_ingame").val() == "") {
        validation = false;
        $("#sale_contact_ingame").parent().addClass("has-error");
        $("#contact_ingame_required").show();
      }

      if($("#sale_server_id").val() == "") {
        validation = false;
        $("#sale_server_id").parent().addClass("has-error");
      }

      if($("#sale_region_id").val() == "") {
        validation = false;
        $("#sale_region_id").parent().addClass("has-error");
      }

      if($("#sale_property_id").val() == "") {
        validation = false;
        $("#sale_property_id").parent().addClass("has-error");
        $("#property_required").show();
      }

      if(imgNotesExecuted) {
        var markers = $("#location_img").imgNotes('export');
        if(markers.length < 1) {
          validation = false;
          $("#location_required").show();
          $("#error_div").show();
        } else {
          $("#sale_x").val(markers[0].x);
          $("#sale_y").val(markers[0].y);
        }
      } else {
        validation = false;
        $("#location_required").show();
        $("#error_div").show();
      }

      if(!$("#rules_agreement").is(':checked')) {
        validation = false;
        $("#agreement_required").show();
        $("#rules_agreement").parent().addClass("has-error");
      }

      return validation;
    }

    function show_rules() {
      $('#rules_div').modal('show');
    }

  </script>
<% end %>

<h2>Sale Registration</h2>

<%= form_for(@sale, url: sales_path(@sale), html: { onsubmit: 'return validates()' }) do |f| %>
  <div class="row-fluid">
    <div class="col-md-4">
      <div class="panel panel-success">
        <div class="panel-heading">
          <h3 class="panel-title">Property and sale informations</h3>
        </div>
        <div class="panel-body">
          <div class="form-group">
            <%= f.text_field(:title, class: 'form-control', placeholder: 'Title') %>
            <span id="title_required" class="error">Can't be blank!</span>
          </div>
          <div class="form-group">
            <%= f.text_field(:price, class: 'form-control', placeholder: 'Price (golds)', onkeypress: 'return validates_number(event)') %>
            <span id="price_required" class="error">Can't be blank!</span>
            <span id="price_invalid" class="error">Only integers!</span>
          </div>
          <div class="form-group">
            <%= f.text_field(:contact_ingame, class: 'form-control', placeholder: "Owner name (character nickname)") %>
            <span id="contact_ingame_required" class="error">Can't be blank!</span>
          </div>
          <div class="form-group">
            <select id="sale_property_id" name="sale[property_id]" class="form-control">
              <option value="">Property</option>
              <% Type.all.each do |type| %>
                <optgroup label="<%= type.name %>">
                  <% type.properties.each do |property| %>
                    <option value="<%= property.id %>"><%= "#{property.name} (#{property.size.name})" %></option>
                  <% end %>
                </optgroup>
              <% end %>
            </select>
            <span id="property_required" class="error">Select the property!</span>
          </div>
          <div class="form-group">
            <%= f.check_box(:appraisal) %> Sale through appraisal certificate?
          </div>
          <div class="form-group">
            <%= f.text_area(:items, class: 'form-control', placeholder: "The property has decorative items? If so, describe them (optional)") %>
          </div>
          <div class="form-group">
            <%= f.text_area(:obs, class: 'form-control', placeholder: "General observations (optional)") %>
          </div>
          <div class="form-group">
            <%= check_box_tag(:rules_agreement) %> I'm aware and agree with the <a href="#" onclick="show_rules()">rules of Archbroker</a>
            <span id="agreement_required" class="error">You have to agree the rules!</span>
          </div>
          <%= f.hidden_field(:x) %>
          <%= f.hidden_field(:y) %>
          <%= f.submit('Done!', class: 'btn btn-success', id: 'commit') %>
        </div>
      </div>
    </div>
    <div class="col-md-8">
      <div class="panel panel-success">
        <div class="panel-heading">
          <h3 class="panel-title">Property location</h3>
        </div>
        <div class="panel-body">
          <div class="row-fluid">
            <div class="col-md-12">
              <p>Please select your server, the property region and then click on the map to indicate the property location.</p>
            </div>
          </div>
          <div class="row-fluid">
            <div class="col-md-5">
              <div class="form-group">
                <select id="sale_server_id" name="sale[server_id]" class="form-control">
                  <option value="">Server</option>
                  <% ServerRegion.all.each do |server_region| %>
                    <optgroup label="<%= server_region.name %>">
                      <% server_region.servers.each do |server| %>
                        <option value="<%= server.id %>"><%= server.name %></option>
                      <% end %>
                    </optgroup>
                  <% end %>
                </select>
              </div>
            </div>
            <div class="col-md-1"></div>
            <div class="col-md-6">
              <div class="form-group">
                <select id="sale_region_id" name="sale[region_id]" class="form-control" onchange="display_map()">
                  <option value="">Region</option>
                  <% Continent.all.each do |continent| %>
                    <optgroup label="<%= continent.name %>">
                      <% continent.regions.each do |region| %>
                        <option value="<%= region.id %>"><%= region.name %></option>
                      <% end %>
                    </optgroup>
                  <% end %>
                </select>
              </div>
            </div>
          </div>
          <div class="row-fluid" id="location_div">
            <img src="/assets/world_map.jpg" id="location_img">
          </div>
          <div class="row-fluid error_div">
            <span id="location_required" class="error">Please, click on the map to mark the property's location!</span>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>

<div class="modal fade" id="rules_div">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
        <h4 class="modal-title">Archbroker Rules</h4>
      </div>
      <div class="modal-body">
        <p>By using Archbroker, you should be aware and agree with the following rules:</p>
        <%= render partial: 'layouts/rules' %>
        <p>Breaking these rules can can result in removal of the sale and/or the Archbroker account.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
      </div>
    </div><!-- /.modal-content -->
  </div><!-- /.modal-dialog -->
</div><!-- /.modal -->